<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpeakSafe.Web</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Offline builds (no NuGet) compile and run with Store=Memory only. -->
    <OfflineBuild Condition="'$(OfflineBuild)' == ''">false</OfflineBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeakSafe.Core\SpeakSafe.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OfflineBuild)' != 'true'">
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
  </ItemGroup>

</Project>
